{
  "schema_version": 1,
  "resource_map_id": "freehand.core-resource-map",
  "resources": [
    {
      "resource_type": "config",
      "owner_feature_id": "config.core",
      "owner_crate": "crates/freehand-config",
      "identity": "agent profile plus config source path",
      "truth_store": "~/.freehand/config.toml",
      "operations": ["load", "validate", "compile_agent_topology", "project_safe_config", "mutate_provider_config", "mutate_agent_resource_topology", "bootstrap_node_pairing", "compile_instruction_capability"],
      "projections": ["runtime bootstrap config", "ordered configured peer topology", "safe CLI/ADP config query"]
    },
    {
      "resource_type": "session",
      "owner_feature_id": "reason.persistence",
      "owner_crate": "crates/freehand-reason",
      "identity": "session_id",
      "truth_store": "~/.freehand/state/turns and ~/.freehand/ledgers/reason",
      "operations": ["create", "append_turn", "append_turn_to_turn", "restore", "list_persisted"],
      "projections": ["ui_session_list", "ui_session_turns", "current-session task attachment view derived through task parent truth"]
    },
    {
      "resource_type": "turn",
      "owner_feature_id": "reason.turn",
      "owner_crate": "crates/freehand-reason",
      "identity": "session_id plus turn_id",
      "truth_store": "~/.freehand/state/turns and reason ledger rows",
      "operations": ["start", "apply_provider_output", "apply_tool_result", "terminalize", "plan_request_context"],
      "projections": ["public conversation", "runtime turn status"]
    },
    {
      "resource_type": "request_context",
      "owner_feature_id": "reason.context-planner",
      "owner_crate": "crates/freehand-blocks",
      "identity": "session_id plus turn_id plus context plan version",
      "truth_store": "typed in-memory context segments plus reason/debug evidence",
      "operations": ["plan_segments", "admit_model_visible_context", "reject_over_budget_context", "build_provider_request"],
      "projections": ["provider-neutral request context"]
    },
    {
      "resource_type": "provider_request",
      "owner_feature_id": "provider.reason-live-bridge",
      "owner_crate": "crates/freehand-runtime",
      "identity": "trace_id plus turn_id plus provider attempt",
      "truth_store": "provider debug ledger when enabled and live bridge attempt state",
      "operations": ["build", "send", "retry_recoverable"],
      "projections": ["provider attempt evidence", "error-center metadata"]
    },
    {
      "resource_type": "provider_response",
      "owner_feature_id": "provider.semantic",
      "owner_crate": "crates/freehand-provider-core",
      "identity": "trace_id plus turn_id plus provider event index",
      "truth_store": "provider semantic event stream and debug raw ledgers",
      "operations": ["normalize", "classify_finish", "map_tool_call", "map_error", "apply_to_turn"],
      "projections": ["reason provider output events", "error-center observed failure"]
    },
    {
      "resource_type": "tool_call",
      "owner_feature_id": "tool.registry",
      "owner_crate": "crates/freehand-tools",
      "identity": "turn_id plus provider tool_call_id",
      "truth_store": "reason turn event plus tool owner execution state",
      "operations": ["declare_schema", "classify_scope", "execute", "execute_workspace_path"],
      "projections": ["tool result text", "tool display semantics"]
    },
    {
      "resource_type": "workspace_path",
      "owner_feature_id": "tool.registry",
      "owner_crate": "crates/freehand-tools",
      "identity": "locked workspace root plus canonicalized path",
      "truth_store": "filesystem under owner-supplied workspace root",
      "operations": ["read_file", "glob", "grep", "ls", "write_file", "edit_file", "multi_edit", "checkpoint_before_write"],
      "projections": ["tool result text", "checkpoint preview"]
    },
    {
      "resource_type": "task",
      "owner_feature_id": "task.orchestration",
      "owner_crate": "crates/freehand-task",
      "identity": "task_id",
      "truth_store": "~/.freehand/state/tasks and ~/.freehand/ledgers/tasks",
      "operations": ["create", "attach_session", "assign", "record_execution", "submit_review", "approve_review", "reject_review", "close", "recover_interrupted", "project_to_ui"],
      "projections": ["TaskBoard", "TaskSpaceSnapshot", "ui_task_snapshot", "current session attachment", "current assignment/lease/execution attachment", "canonical Worker transcript session identity"]
    },
    {
      "resource_type": "agent",
      "owner_feature_id": "agent.lifecycle",
      "owner_crate": "crates/freehand-task",
      "identity": "agent_id independent of session; task assignment, lease, and execution are temporary bindings",
      "truth_store": "AgentBoard projection from lifecycle events",
      "operations": ["register", "heartbeat", "claim_task", "release_task"],
      "projections": ["AgentBoard reusable resource pool", "TaskSpaceSnapshot", "current task/execution occupancy"]
    },
    {
      "resource_type": "timer",
      "owner_feature_id": "runtime.master-worker-loop",
      "owner_crate": "crates/freehand-runtime",
      "identity": "timer_id",
      "truth_store": "~/.freehand/state/timers and ~/.freehand/ledgers/timers",
      "operations": ["schedule", "cancel", "list", "fire_due", "fire_master_wakeup", "reschedule_recurring"],
      "projections": ["timer tool result", "source-session injected prompt turn", "source-less internal master wakeup turn"]
    },
    {
      "resource_type": "error",
      "owner_feature_id": "error.center",
      "owner_crate": "crates/freehand-control",
      "identity": "trace_id plus domain plus attempt",
      "truth_store": "~/.freehand/ledgers/metadata error.center rows",
      "operations": ["classify", "record", "record_metadata", "decide_recovery", "query_projection"],
      "projections": ["ADP error query", "runtime recovery decision"]
    },
    {
      "resource_type": "metadata",
      "owner_feature_id": "metadata.core",
      "owner_crate": "crates/freehand-metadata",
      "identity": "metadata entry id plus writer owner plus write node",
      "truth_store": "~/.freehand/ledgers/metadata",
      "operations": ["validate_entry", "append", "query"],
      "projections": ["owner-scoped metadata query"]
    },
    {
      "resource_type": "debug_trace",
      "owner_feature_id": "debug.core",
      "owner_crate": "crates/freehand-debug",
      "identity": "trace_id plus scene coordinate",
      "truth_store": "~/.freehand/logs and debug snapshots",
      "operations": ["emit_snapshot", "fanout", "read_snapshot"],
      "projections": ["debug artifacts"]
    },
    {
      "resource_type": "ui_projection",
      "owner_feature_id": "ui.protocol",
      "owner_crate": "crates/freehand-ui-protocol",
      "identity": "query type plus resource id",
      "truth_store": "derived protocol projection, not independent truth",
      "operations": ["query", "subscribe", "project_public_state", "dispatch_command"],
      "projections": ["CLI/WebUI/Android protocol frames"]
    },
    {
      "resource_type": "runtime_command",
      "owner_feature_id": "runtime.ui-command-dispatch",
      "owner_crate": "crates/freehand-runtime",
      "identity": "command id plus target feature id",
      "truth_store": "runtime command dispatcher state and owner module effects",
      "operations": ["dispatch", "route_to_owner", "return_receipt", "rewind_checkpoint"],
      "projections": ["UI command receipt", "owner operation effect"]
    },
    {
      "resource_type": "checkpoint",
      "owner_feature_id": "runtime.checkpoint-rewind",
      "owner_crate": "crates/freehand-runtime",
      "identity": "agent id plus session id plus checkpoint id",
      "truth_store": "~/.freehand/state/checkpoints and ~/.freehand/ledgers/checkpoints",
      "operations": ["preview", "snapshot", "apply_tool_after_checkpoint", "rewind", "list"],
      "projections": ["checkpoint summary", "rewind command receipt"]
    },
    {
      "resource_type": "node_pairing",
      "owner_feature_id": "node.master-slave",
      "owner_crate": "crates/freehand-node",
      "identity": "source node id plus target node id plus pair token boundary",
      "truth_store": "node runtime pairing state plus metadata/debug evidence",
      "operations": ["validate_pairing", "accept_pairing", "lose_pairing", "delegate_task", "publish_slave_turn", "query_status", "project_to_ui"],
      "projections": ["node status", "delegated task progress", "slave turn stream"]
    },
    {
      "resource_type": "instruction_capability",
      "owner_feature_id": "instruction.capability-loader",
      "owner_crate": "crates/freehand-instructions",
      "identity": "capability source path plus scope plus precedence",
      "truth_store": "compiled deterministic instruction capability manifest under runtime state",
      "operations": ["discover", "validate", "compile_manifest", "write_manifest", "admit_request_context"],
      "projections": ["instruction capability manifest", "manifest error records"]
    }
  ],
  "operation_bindings": [
    {
      "operation_id": "session.append_turn_to_turn",
      "owner_feature_id": "reason.persistence",
      "source_resource": "session",
      "target_resource": "turn",
      "effect": "append a turn under one persisted session",
      "mainline_call_doc": "docs/mainline-calls/reason.persistence.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "turn.plan_request_context",
      "owner_feature_id": "reason.context-planner",
      "source_resource": "turn",
      "target_resource": "request_context",
      "effect": "derive model-visible context through the planner owner",
      "mainline_call_doc": "docs/mainline-calls/reason.context-planner.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "request_context.build_provider_request",
      "owner_feature_id": "provider.reason-live-bridge",
      "source_resource": "request_context",
      "target_resource": "provider_request",
      "effect": "build provider-selected live request without provider DTO leakage",
      "mainline_call_doc": "docs/mainline-calls/provider.reason-live-bridge.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "provider_response.apply_to_turn",
      "owner_feature_id": "reason.turn",
      "source_resource": "provider_response",
      "target_resource": "turn",
      "effect": "apply normalized provider output to turn truth",
      "mainline_call_doc": "docs/mainline-calls/reason.turn.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "tool_call.execute_workspace_path",
      "owner_feature_id": "tool.registry",
      "source_resource": "tool_call",
      "target_resource": "workspace_path",
      "effect": "execute governed workspace file/search/write operation",
      "mainline_call_doc": "docs/mainline-calls/tool.registry.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "task.project_to_ui",
      "owner_feature_id": "ui.protocol",
      "source_resource": "task",
      "target_resource": "ui_projection",
      "effect": "project task truth to UI without UI owning task state",
      "mainline_call_doc": "docs/mainline-calls/ui.protocol.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "task.create",
      "owner_feature_id": "task.orchestration",
      "source_resource": "task",
      "target_resource": "session",
      "effect": "persist optional parent session identity on the task without making the assigned agent session-owned",
      "mainline_call_doc": "docs/mainline-calls/task.orchestration.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "task.assign",
      "owner_feature_id": "task.orchestration",
      "source_resource": "task",
      "target_resource": "agent",
      "effect": "bind one schedulable task to one available agent through a replaceable assignment while preserving task and parent session identity",
      "mainline_call_doc": "docs/mainline-calls/task.orchestration.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "task.attach_session",
      "owner_feature_id": "task.orchestration",
      "source_resource": "task",
      "target_resource": "session",
      "effect": "persist an observing user-session attachment without changing the task's immutable creation parent or granting mutation authority",
      "mainline_call_doc": "docs/mainline-calls/task.orchestration.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "agent.heartbeat",
      "owner_feature_id": "agent.lifecycle",
      "source_resource": "agent",
      "target_resource": "agent",
      "effect": "record typed process start and heartbeat truth and derive query-time Worker health",
      "mainline_call_doc": "docs/mainline-calls/agent.lifecycle.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "timer.fire_master_wakeup",
      "owner_feature_id": "runtime.master-worker-loop",
      "source_resource": "timer",
      "target_resource": "turn",
      "effect": "inject a source-backed due timer's persisted prompt as a new turn in its original session, or execute a source-less timer as an internal wakeup",
      "mainline_call_doc": "docs/mainline-calls/runtime.master-worker-loop.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "error.record_metadata",
      "owner_feature_id": "error.center",
      "source_resource": "error",
      "target_resource": "metadata",
      "effect": "write classified error truth through metadata owner constraints",
      "mainline_call_doc": "docs/mainline-calls/error.center.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "workspace_path.checkpoint_before_write",
      "owner_feature_id": "runtime.checkpoint-rewind",
      "source_resource": "workspace_path",
      "target_resource": "checkpoint",
      "effect": "create checkpoint truth from writable-tool preview before workspace mutation",
      "mainline_call_doc": "docs/mainline-calls/runtime.checkpoint-rewind.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "runtime_command.rewind_checkpoint",
      "owner_feature_id": "runtime.checkpoint-rewind",
      "source_resource": "runtime_command",
      "target_resource": "checkpoint",
      "effect": "route explicit rewind commands through checkpoint owner before workspace restore",
      "mainline_call_doc": "docs/mainline-calls/runtime.checkpoint-rewind.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "config.bootstrap_node_pairing",
      "owner_feature_id": "node.master-slave",
      "source_resource": "config",
      "target_resource": "node_pairing",
      "effect": "materialize one config-approved relation from the compiled reciprocal Master/Worker peer topology into node runtime state",
      "mainline_call_doc": "docs/mainline-calls/node.master-slave.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "node_pairing.project_to_ui",
      "owner_feature_id": "node.master-slave",
      "source_resource": "node_pairing",
      "target_resource": "ui_projection",
      "effect": "project node status, delegated progress, and slave turns without UI owning pairing truth",
      "mainline_call_doc": "docs/mainline-calls/node.master-slave.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "config.compile_instruction_capability",
      "owner_feature_id": "instruction.capability-loader",
      "source_resource": "config",
      "target_resource": "instruction_capability",
      "effect": "compile deterministic instruction capability manifest from configured global and local sources",
      "mainline_call_doc": "docs/mainline-calls/instruction.capability-loader.json",
      "binding_status": "bound"
    },
    {
      "operation_id": "instruction_capability.admit_request_context",
      "owner_feature_id": "instruction.capability-loader",
      "source_resource": "instruction_capability",
      "target_resource": "request_context",
      "effect": "admit compiled instruction capabilities into provider-visible request context only as typed context-planner segments",
      "mainline_call_doc": "docs/mainline-calls/instruction.capability-loader.json",
      "binding_status": "bound"
    }
  ],
