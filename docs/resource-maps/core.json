  "relation_rules": [
    {
      "rule_id": "session-appends-turn-direct",
      "source_resource": "session",
      "target_resource": "turn",
      "allowed_direct": true,
      "via_resources": [],
      "reason": "Session persistence owner may append turn truth under the persisted session."
