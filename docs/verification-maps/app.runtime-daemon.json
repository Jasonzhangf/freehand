  "test_design": "docs/testing/app.runtime-daemon.md",
  "gates": [
    {
      "gate_id": "app.runtime-daemon.unit",
      "kind": "test",
      "command": "cargo test -p freehand-daemon -- --nocapture",
      "binding_status": "active"
    },
    {
      "gate_id": "app.runtime-daemon.clippy",
      "kind": "lint",
      "command": "cargo clippy -p freehand-daemon --all-targets -- -D warnings",
      "binding_status": "active"
    },
    {
      "gate_id": "app.runtime-daemon.launchd-offline",
      "kind": "test",
      "command": "bash scripts/verify-launchd-restart-guard.sh",
      "binding_status": "active"
    },
    {
      "gate_id": "app.runtime-daemon.launchd-online",
      "kind": "project-blackbox",
      "command": "bash scripts/verify-launchd-restart-guard-online.sh",
      "binding_status": "active"
    },
    {
      "gate_id": "app.runtime-daemon.architecture",
      "kind": "architecture",
      "command": "cargo run -p xtask -- gates check",
      "binding_status": "active"
    }
  ]
}
