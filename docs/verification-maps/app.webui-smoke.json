{
  "schema_version": 1,
  "verification_map_id": "app.webui-smoke.verification",
  "feature_id": "app.webui-smoke",
  "status": "active",
  "module_registry": "docs/module-registry/app.webui-smoke.json",
  "function_map": "docs/function-maps/app.webui-smoke.md",
  "mainline_call_map": "docs/mainline-calls/app.webui-smoke.json",
  "test_design": "docs/testing/app.webui-smoke.md",
  "gates": [
    {
      "gate_id": "app.webui-smoke.foundation-contracts",
      "kind": "test",
      "command": "node scripts/verify-webui-foundation-contracts.mjs",
      "binding_status": "active"
    },
    {
      "gate_id": "app.webui-smoke.unit",
      "kind": "test",
      "command": "cargo test -p freehand-server -- --nocapture",
      "binding_status": "active"
    },
    {
      "gate_id": "app.webui-smoke.clippy",
      "kind": "lint",
      "command": "cargo clippy -p freehand-server --all-targets -- -D warnings",
      "binding_status": "active"
    },
    {
      "gate_id": "app.webui-smoke.architecture",
      "kind": "architecture",
      "command": "cargo run -p xtask -- gates check",
      "binding_status": "active"
    },
    {
      "gate_id": "app.webui-smoke.surface-motion-online",
      "kind": "project-blackbox",
      "command": "node scripts/verify-webui-surface-motion-online.mjs",
      "binding_status": "active"
    }
  ]
}
