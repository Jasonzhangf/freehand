<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 浅色主题 -->
    <style name="Theme.Freehand.Light" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/fh_accent</item>
        <item name="colorPrimaryDark">@color/fh_accent_dark</item>
        <item name="colorAccent">@color/fh_accent</item>
        <item name="android:windowBackground">@color/fh_startup_background</item>
        <item name="android:statusBarColor">@color/fh_startup_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/fh_startup_background</item>
    </style>

    <!-- 深色主题 -->
    <style name="Theme.Freehand.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/fh_accent</item>
        <item name="colorPrimaryDark">@color/fh_accent_dark</item>
        <item name="colorAccent">@color/fh_accent</item>
        <item name="android:windowBackground">@color/fh_bg_primary_dark</item>
        <item name="android:statusBarColor">@color/fh_bg_primary_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/fh_bg_primary_dark</item>
    </style>

</resources>
