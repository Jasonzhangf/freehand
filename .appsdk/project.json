      "module_id": "v2-contracts",
      "owned_paths": [
        "playground/experiments/v2/contracts/Cargo.lock",
        "playground/experiments/v2/contracts/Cargo.toml",
        "playground/experiments/v2/contracts/src/**",
        "tests/v2/contracts/**"
      ],
      "regression": {
        "allow_skipped": false,
        "command": {
          "args": [
            "test",
            "--manifest-path",
            "playground/experiments/v2/contracts/Cargo.toml",
            "--test",
            "v2_contract_boundary"
          ],
          "program": "cargo",
          "working_directory": "."
        },
        "input_paths": [
          "playground/experiments/v2/contracts/Cargo.lock",
          "playground/experiments/v2/contracts/Cargo.toml",
          "playground/experiments/v2/contracts/src/**",
          "tests/v2/contracts/**"
        ],
        "minimum_test_count": 8,
        "ordinary_mode_after_freeze": "disabled",
        "reenable_on": [
          "source_change",
          "contract_change",
          "public_api_change",
          "artifact_change",
          "dependency_change"
        ],
        "required_before_freeze": true,
        "suite_id": "v2-contracts-regression"
      },
      "source_owner": "v2-contracts",
      "stage": "source_implemented"
    },
